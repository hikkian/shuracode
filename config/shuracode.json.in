{
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "tiel-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Shura (local)",
      "options": {
        "baseURL": "@BASE_URL@"
      },
      "models": {
        "tiel-coder": {
          "name": "Tiel-Coder 35B-A3B (local, 200K ctx) — faster, the default",
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 200000, "output": 16384 },
          "options": { "temperature": 0.6, "top_p": 0.95, "top_k": 20 },
          "settings": { "reasoningEffort": "medium" },
          "variants": {
            "fast": { "settings": { "reasoningEffort": "minimal" } },
            "low": { "settings": { "reasoningEffort": "low" } },
            "medium": { "settings": { "reasoningEffort": "medium" } },
            "high": { "settings": { "reasoningEffort": "high" } },
            "max": { "settings": { "reasoningEffort": "max" } }
          }
        },
        "sage": {
          "name": "Sage-A1.5 35B-A3B (local, 200K ctx) — stronger on hard tasks",
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 200000, "output": 16384 },
          "options": { "temperature": 1.0, "top_p": 0.95, "top_k": 20, "presence_penalty": 1.5, "min_p": 0.0 },
          "settings": { "reasoningEffort": "medium" },
          "variants": {
            "fast": { "settings": { "reasoningEffort": "minimal" } },
            "low": { "settings": { "reasoningEffort": "low" } },
            "medium": { "settings": { "reasoningEffort": "medium" } },
            "high": { "settings": { "reasoningEffort": "high" } },
            "max": { "settings": { "reasoningEffort": "max" } }
          }
        }
      }
    },
    "gemma-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Shura (local, Gemma)",
      "options": {
        "baseURL": "@BASE_URL@"
      },
      "models": {
        "gemma": {
          "name": "Gemma 4 26B-A4B (local, 200K ctx)",
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 200000, "output": 16384 },
          "options": { "temperature": 0.6, "top_p": 0.95, "top_k": 20 },
          "settings": { "reasoningEffort": "medium" },
          "variants": {
            "fast": { "settings": { "reasoningEffort": "minimal" } },
            "low": { "settings": { "reasoningEffort": "low" } },
            "medium": { "settings": { "reasoningEffort": "medium" } },
            "high": { "settings": { "reasoningEffort": "high" } },
            "max": { "settings": { "reasoningEffort": "max" } }
          }
        }
      }
    }
  },
  "model": "tiel-local/tiel-coder",
  "small_model": "tiel-local/tiel-coder",
  "plugin": [
    "@REPO_DIR@/plugin/server.ts",
    ["@REPO_DIR@/plugin/reliability/completion-gate.ts", { "completionGate": false }],
    ["@REPO_DIR@/plugin/reliability/soft-edit.ts", { "softEdit": false }],
    ["@REPO_DIR@/plugin/reliability/loop-detector.ts", { "loopDetector": false }],
    ["@REPO_DIR@/plugin/reliability/task-card.ts", { "taskCard": false }],
    ["@REPO_DIR@/plugin/reliability/interrupt-retry.ts", { "interruptRetry": false }],
    ["@REPO_DIR@/plugin/visible-tests.ts", { "visibleTests": false }],
    ["@REPO_DIR@/plugin/model-harness.ts", { "harnessDir": "@REPO_DIR@/config/harness", "userHarnessDir": "~/.local/share/shura/skills" }],
    ["@REPO_DIR@/plugin/context-diet.ts", { "contextDiet": false }]
  ],
  "instructions": ["~/.config/shuracode/AGENTS.md", "~/.local/share/shuracode/memory/MEMORY.md"],
  "agent": {
    "build": {},
    "plan": {
      "description": "Plan mode: reads the code and proposes a plan. Cannot edit files or run commands that change anything.",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git blame*": "allow",
          "ls*": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "pwd": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "find *": "allow",
          "find * -delete*": "deny",
          "find * -exec*": "ask",
          "tree*": "allow",
          "curl *127.0.0.1*": "allow",
          "curl *localhost*": "allow",
          "*>*": "ask",
          "*tee *": "ask"
        }
      }
    },
    "general": {},
    "explore": {}
  },
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git show*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "npm test*": "allow",
      "npm run*": "allow",
      "npm install*": "allow",
      "pytest*": "allow",
      "python -m pytest*": "allow",
      "python3 -m pytest*": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "node *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "ls*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "pwd": "allow",
      "curl *127.0.0.1*": "allow",
      "curl *localhost*": "allow",
      "git push*": "ask",
      "*rules.py enable*": "ask",
      "*rules.py disable*": "ask",
      "*rules.py render*": "ask",
      "*rules.py withdraw*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "git rebase*": "ask",
      "sudo *": "ask",
      "dd *": "ask",
      "chmod -R*": "ask",
      "chown -R*": "ask",
      "rm -rf*": "deny",
      "rm -fr*": "deny",
      "mkfs*": "deny",
      "wipefs*": "deny",
      "fdisk*": "deny",
      "parted*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "poweroff*": "deny",
      "systemctl poweroff*": "deny",
      "systemctl reboot*": "deny"
    },
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  },
  "mcp": {
    "memory": {
      "type": "local",
      "command": ["python3", "@REPO_DIR@/mcp/memory.py"],
      "enabled": true
    },
    "rules": {
      "type": "local",
      "command": ["python3", "@REPO_DIR@/mcp/rules.py"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["node", "@REPO_DIR@/mcp/mcp-tool-filter.js", "@REPO_DIR@/mcp/playwright-tools-allowlist.json", "--", "npx", "-y", "@playwright/mcp@latest", "--isolated", "--browser", "chromium"],
      "enabled": true
    },
    "searxng": {
      "type": "local",
      "command": ["node", "@REPO_DIR@/mcp/mcp-tool-filter.js", "@REPO_DIR@/mcp/searxng-tools-allowlist.json", "--", "npx", "-y", "mcp-searxng"],
      "environment": { "SEARXNG_URL": "http://127.0.0.1:8888" },
      "enabled": true
    }
  }
}
